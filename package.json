    "youtube:acceptance:live": "node scripts/run-youtube-captured-acceptance.mjs",
    "youtube:acceptance:review-packet": "node scripts/build-youtube-human-review-packet.mjs --outputs .cache/youtube-acceptance/retest-v6-final",
    "youtube:acceptance:review:export": "python services/youtube-ingestion/review_acceptance_annotations.py export --manifest services/youtube-ingestion/acceptance/manifest.json --output .cache/youtube-acceptance/human-review.json",
    "youtube:acceptance:review:apply": "python services/youtube-ingestion/review_acceptance_annotations.py apply --manifest services/youtube-ingestion/acceptance/manifest.json --review .cache/youtube-acceptance/human-review.json --output-dir .cache/youtube-acceptance/reviewed",
    "youtube:acceptance:review:evaluate": "python services/youtube-ingestion/acceptance_evaluator.py --manifest .cache/youtube-acceptance/reviewed/manifest.json --outputs .cache/youtube-acceptance/retest-v6-final --report .cache/youtube-acceptance/reviewed-report.json",
    "youtube:acceptance:fixture": "python services/youtube-ingestion/acceptance_evaluator.py --manifest services/youtube-ingestion/acceptance/fixture-manifest.json --outputs .cache/youtube-acceptance/outputs --report .cache/youtube-acceptance/fixture-report.json",
    "test:youtube:python": "python -m unittest services/youtube-ingestion/test_ingestion.py",
    "smoke:item-localization": "node scripts/refresh-item-localization.mjs --remote --check --strict-localization",
    "refresh:item-localization": "node scripts/refresh-item-localization.mjs",
    "audit:aliases": "node scripts/audit-alias-coverage.mjs",
    "audit:items": "node scripts/audit-item-availability.mjs",
    "audit:item-patch": "node scripts/audit-item-patch.mjs",
    "opgg:collect": "node scripts/opgg-collect.mjs",
    "opgg:collect:watch": "node scripts/opgg-collect.mjs --watch-interval-min 60",
    "opgg:trends": "node scripts/opgg-trends.mjs",
    "opgg:review": "node scripts/opgg-review.mjs",
    "opgg:teaching": "node scripts/opgg-teaching.mjs",
    "opgg:stats": "node scripts/opgg-collect.mjs --stats",
    "maintain:comp-profiles": "node scripts/apply-comp-profile-maintenance.mjs --write",
    "refresh:assets": "node scripts/refresh-asset-manifest.mjs",
    "audit:assets": "node scripts/refresh-asset-manifest.mjs --check",
    "capture:s17": "node scripts/capture-s17-mechanism-cases.mjs",
    "discover:s17": "node scripts/discover-s17-mechanism-factors.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "pg": "8.16.3",
    "pinyin-pro": "3.29.3",
    "redis": "5.8.2"
  }
}
