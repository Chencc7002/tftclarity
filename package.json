    "stats:scheduler": "node scripts/schedule-metatft-current-stats.mjs --daemon",
    "stats:schedule:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-current-stats-task.ps1",
    "smoke:current-stats": "node scripts/smoke-metatft-current-stats-rag.mjs",
    "smoke:current-stats:http": "node scripts/smoke-current-stats-http-e2e.mjs",
    "current-stats:e2e-server": "node scripts/start-current-stats-e2e-server.mjs",
