    "smoke:entity-slang": "node scripts/smoke-entity-slang.mjs",
    "eval:phase2": "node scripts/run-phase2-eval.mjs",
    "eval:phase3": "node scripts/run-phase3-eval.mjs",
    "eval:phase4": "node scripts/run-phase4-eval.mjs",
    "eval:phase5": "node scripts/run-phase5-eval.mjs",
    "eval:phase6": "node scripts/run-phase6-eval.mjs",
    "eval:phase65": "node scripts/run-phase65-eval.mjs",
    "eval:phase66": "node scripts/run-phase66-eval.mjs",
    "eval:phase8a": "node scripts/run-phase8a-eval.mjs",
