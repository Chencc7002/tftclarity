# Public hostname. Example: tft.example.com
DOMAIN=tft.example.com

# Generate with: openssl rand -base64 48
TFT_AGENT_VISITOR_SECRET=CHANGE_ME

# Generate separately. Required to read protected /api/admin/* endpoints.
TFT_AGENT_ADMIN_TOKEN=CHANGE_ME_TOO

# Anonymous AI budgets. One real provider request consumes one use.
TFT_AGENT_VISITOR_DAILY_LLM_LIMIT=10
TFT_AGENT_IP_DAILY_LLM_LIMIT=20
TFT_AGENT_GLOBAL_DAILY_LLM_LIMIT=50
TFT_AGENT_REQUESTS_PER_MINUTE=30

# Feedback abuse controls and server-side query snapshot retention.
TFT_AGENT_FEEDBACK_VISITOR_PER_MINUTE=20
TFT_AGENT_FEEDBACK_IP_PER_MINUTE=60
TFT_AGENT_QUERY_EVENT_RETENTION_DAYS=30

# PostgreSQL and Redis. Use different generated passwords for every role/service.
POSTGRES_DB=tftagent
POSTGRES_USER=tftagent_migrator
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_ADMIN
TFT_AGENT_DATABASE_APP_USER=tftagent_app
TFT_AGENT_DATABASE_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS
DATABASE_URL=postgresql://tftagent_app:CHANGE_ME_APP_PASSWORD@postgres:5432/tftagent
TFT_AGENT_MIGRATION_DATABASE_URL=postgresql://tftagent_migrator:CHANGE_ME_DATABASE_ADMIN@postgres:5432/tftagent
REDIS_URL=redis://:CHANGE_ME_REDIS@redis:6379/0
TFT_AGENT_PERSISTENT_STORE=postgres
TFT_AGENT_EPHEMERAL_STORE=redis
TFT_AGENT_DATABASE_SSL=disable
TFT_AGENT_DATABASE_POOL_MAX=10
TFT_AGENT_DATABASE_IDLE_TIMEOUT_MS=30000
TFT_AGENT_DATABASE_CONNECT_TIMEOUT_MS=5000
TFT_AGENT_DATABASE_STATEMENT_TIMEOUT_MS=10000
TFT_AGENT_REDIS_PREFIX=tft:v1
TFT_AGENT_REDIS_CONNECT_TIMEOUT_MS=5000
TFT_AGENT_STORAGE_ALLOW_MEMORY_FALLBACK=false
TFT_AGENT_WORKER_CONCURRENCY=2
TFT_AGENT_CONCLUSION_JOB_TTL_MS=1800000
TFT_AGENT_CONCLUSION_JOB_ATTEMPTS=2
TFT_AGENT_CONCLUSION_JOB_BACKOFF_MS=1000
TFT_AGENT_STATS_PRIMARY_PROVIDER=metatft
TFT_AGENT_STATS_SHADOW_PROVIDER=off
TFT_AGENT_PROVIDER_FALLBACK=off
RIOT_API_ENABLED=false

# Optional structured parsing LLM. Keep "never" to launch without this cost.
TFT_AGENT_LLM_MODE=never
# TFT_AGENT_LLM_PROVIDER=chat
# TFT_AGENT_LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
# TFT_AGENT_LLM_MODEL=your-model
# TFT_AGENT_LLM_API_KEY=replace-me
# TFT_AGENT_LLM_TIMEOUT_MS=1500

# Persistent semantic vector index. Build it with: npm run semantic:index
# The endpoint may be an OpenAI-compatible /v1 base URL or a full /embeddings URL.
TFT_AGENT_EMBEDDING_MODE=off
# TFT_AGENT_EMBEDDING_PROVIDER=openai_compatible
# TFT_AGENT_EMBEDDING_ENDPOINT=https://your-provider.example/v1
# TFT_AGENT_EMBEDDING_MODEL=your-embedding-model
# TFT_AGENT_EMBEDDING_API_KEY=replace-me
# TFT_AGENT_EMBEDDING_DIMENSIONS=1024
# TFT_AGENT_EMBEDDING_TIMEOUT_MS=8000
# TFT_AGENT_EMBEDDING_BATCH_SIZE=64
TFT_AGENT_SEMANTIC_INDEX_PATH=.cache/semantic-index.sqlite
TFT_AGENT_SEMANTIC_LOCALE=zh-CN

# Optional evidence-backed answer generation. Keep "off" to launch without it.
TFT_AGENT_CONCLUSION_MODE=off
# TFT_AGENT_CONCLUSION_PROVIDER=openai_compatible
# TFT_AGENT_CONCLUSION_ENDPOINT=https://your-provider.example/v1
# TFT_AGENT_CONCLUSION_MODEL=your-model
# TFT_AGENT_CONCLUSION_API_KEY=replace-me
# TFT_AGENT_CONCLUSION_TIMEOUT_MS=10000
# TFT_AGENT_CONCLUSION_MAX_OUTPUT_TOKENS=1600
# TFT_AGENT_CONCLUSION_MAX_CORRECTIONS=2
# TFT_AGENT_CONCLUSION_MAX_VALIDATION_ERRORS=8
# TFT_AGENT_CONCLUSION_MAX_TRANSPORT_RETRIES=1
# TFT_AGENT_CONCLUSION_THINKING=disabled
# TFT_AGENT_CONCLUSION_REASONING_EFFORT=

TFT_AGENT_EXPLORER_TIMEOUT_MS=2200
TFT_AGENT_CATALOG_TIMEOUT_MS=2200
TFT_AGENT_COMPS_TIMEOUT_MS=2200
