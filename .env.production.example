# Public hostname. Example: tft.example.com
DOMAIN=tft.example.com

# Generate with: openssl rand -base64 48
TFT_AGENT_VISITOR_SECRET=CHANGE_ME

# Generate separately. Required to read protected /api/admin/* endpoints.
TFT_AGENT_ADMIN_TOKEN=CHANGE_ME_TOO

# Anonymous AI budgets. One real provider request consumes one use.
TFT_AGENT_VISITOR_DAILY_LLM_LIMIT=10
TFT_AGENT_IP_DAILY_LLM_LIMIT=20
TFT_AGENT_GLOBAL_DAILY_LLM_LIMIT=50
TFT_AGENT_REQUESTS_PER_MINUTE=30

# Feedback abuse controls and server-side query snapshot retention.
TFT_AGENT_FEEDBACK_VISITOR_PER_MINUTE=20
TFT_AGENT_FEEDBACK_IP_PER_MINUTE=60
TFT_AGENT_QUERY_EVENT_RETENTION_DAYS=30

# Optional structured parsing LLM. Keep "never" to launch without this cost.
TFT_AGENT_LLM_MODE=never
# TFT_AGENT_LLM_PROVIDER=chat
# TFT_AGENT_LLM_ENDPOINT=https://your-provider.example/v1/chat/completions
# TFT_AGENT_LLM_MODEL=your-model
# TFT_AGENT_LLM_API_KEY=replace-me
# TFT_AGENT_LLM_TIMEOUT_MS=1500
# Outer deadline for the complete parse -> retrieve -> answer pipeline.
TFT_AGENT_RUN_DEADLINE_MS=60000

# Persistent semantic vector index. Build it with: npm run semantic:index
# The endpoint may be an OpenAI-compatible /v1 base URL or a full /embeddings URL.
# Keep this on to retrieve imported knowledge through local TF-IDF even when
# remote embeddings are off.
TFT_AGENT_KNOWLEDGE_MODE=on
TFT_AGENT_EMBEDDING_MODE=off
# TFT_AGENT_EMBEDDING_PROVIDER=openai_compatible
# TFT_AGENT_EMBEDDING_ENDPOINT=https://your-provider.example/v1
# TFT_AGENT_EMBEDDING_MODEL=your-embedding-model
# TFT_AGENT_EMBEDDING_API_KEY=replace-me
# TFT_AGENT_EMBEDDING_DIMENSIONS=1024
# TFT_AGENT_EMBEDDING_TIMEOUT_MS=8000
# TFT_AGENT_EMBEDDING_BATCH_SIZE=64
TFT_AGENT_SEMANTIC_INDEX_PATH=.cache/semantic-index.sqlite
TFT_AGENT_SEMANTIC_LOCALE=zh-CN

# current_stats semanticProjection policy. No Top-N boundary exception is
# enabled unless CURRENT_STATS_CRITICAL_RANK_BOUNDARIES is explicitly set.
CURRENT_STATS_AVG_PLACEMENT_DECIMALS=2
CURRENT_STATS_RATE_PERCENTAGE_DECIMALS=1
CURRENT_STATS_RANK_CHANGE_THRESHOLD=2
CURRENT_STATS_CRITICAL_RANK_BOUNDARIES=
CURRENT_STATS_SEASON=set17-live
CURRENT_STATS_PATCH=17.8
CURRENT_STATS_RANK=CHALLENGER,DIAMOND,EMERALD,GRANDMASTER,MASTER,PLATINUM
CURRENT_STATS_DAYS=3
CURRENT_STATS_REGION=global
CURRENT_STATS_LOCALE=zh-CN
CURRENT_STATS_TTL_HOURS=48

# Optional evidence-backed answer generation. Keep "off" to launch without it.
TFT_AGENT_CONCLUSION_MODE=off
# TFT_AGENT_CONCLUSION_PROVIDER=openai_compatible
# TFT_AGENT_CONCLUSION_ENDPOINT=https://your-provider.example/v1
# TFT_AGENT_CONCLUSION_MODEL=your-model
# TFT_AGENT_CONCLUSION_API_KEY=replace-me
# TFT_AGENT_CONCLUSION_TIMEOUT_MS=10000
# TFT_AGENT_CONCLUSION_MAX_OUTPUT_TOKENS=1600
# TFT_AGENT_CONCLUSION_MAX_CORRECTIONS=2
# TFT_AGENT_CONCLUSION_MAX_VALIDATION_ERRORS=8
# TFT_AGENT_CONCLUSION_MAX_TRANSPORT_RETRIES=1
# TFT_AGENT_CONCLUSION_THINKING=disabled
# TFT_AGENT_CONCLUSION_REASONING_EFFORT=

# Optional hybrid strategy answer. If omitted, it reuses the conclusion
# provider above. MetaTFT remains authoritative for current-best rankings.
# TFT_AGENT_COACH_MODE=on
# TFT_AGENT_COACH_PROVIDER=openai_compatible
# TFT_AGENT_COACH_ENDPOINT=https://your-provider.example/v1
# TFT_AGENT_COACH_MODEL=your-model
# TFT_AGENT_COACH_API_KEY=replace-me
# TFT_AGENT_COACH_TIMEOUT_MS=10000
# TFT_AGENT_COACH_MAX_OUTPUT_TOKENS=1600

# Optional at-rest encryption for OP.GG player PUUIDs. Use a long random
# secret. When omitted, PUUIDs are resolved for each poll and are not stored.
# OPGG_PUUID_ENCRYPTION_KEY=replace-with-a-long-random-secret
# Optional timeout for one OP.GG LLM teaching attempt. Invalid model output
# may be retried once, so the browser allows roughly twice this duration.
# TFT_AGENT_OPGG_TEACHING_TIMEOUT_MS=60000

# YouTube extraction overrides. The local importer defaults to the
# coach/conclusion provider when these values are omitted.
# TFT_AGENT_YOUTUBE_EXTRACTION_ENDPOINT=https://api.deepseek.com/v1
# TFT_AGENT_YOUTUBE_EXTRACTION_MODEL=deepseek-v4-flash
# TFT_AGENT_YOUTUBE_EXTRACTION_API_KEY=replace-me
# TFT_AGENT_YOUTUBE_EXTRACTION_TIMEOUT_MS=30000
# TFT_AGENT_YOUTUBE_EXTRACTION_MAX_OUTPUT_TOKENS=4000
# DeepSeek V4 defaults to thinking mode; JSON extraction should keep this disabled.
# Use auto to omit the provider-specific request field on other compatible endpoints.
# TFT_AGENT_YOUTUBE_EXTRACTION_THINKING_MODE=disabled
# Transient HTTP/TLS failures are retried before a segment is quarantined.
# TFT_AGENT_YOUTUBE_EXTRACTION_TRANSPORT_RETRIES=2
# TFT_AGENT_YOUTUBE_EXTRACTION_TRANSPORT_RETRY_DELAY_MS=1000
# TFT_AGENT_YOUTUBE_EXTRACTION_RETRY_EMPTY_ONCE=true
# TFT_AGENT_YOUTUBE_EXTRACTION_PROMPT_VERSION=youtube-guide-extraction.v6

TFT_AGENT_EXPLORER_TIMEOUT_MS=2200
TFT_AGENT_CATALOG_TIMEOUT_MS=2200
TFT_AGENT_COMPS_TIMEOUT_MS=2200
