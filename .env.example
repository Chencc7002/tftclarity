# OpenAI-compatible provider. Copy this file to .env and replace the placeholders.
OPENAI_API_KEY=your_openai_compatible_api_key
OPENAI_BASE_URL=https://aihubmix.com/v1

# Bilibili strategy-video search. Run bilibili-mcp-js separately with
# TRANSPORT=remote and point this app at its /mcp endpoint. Keep the endpoint
# on localhost or a trusted internal network; the upstream server has no auth.
BILIBILI_MCP_MODE=auto
BILIBILI_MCP_TRANSPORT=streamable_http
BILIBILI_MCP_ENDPOINT=http://127.0.0.1:3000/mcp
BILIBILI_MCP_SEARCH_TOOL=bilibili-search-summary
BILIBILI_MCP_DETAIL_TOOL=bilibili-video-detail
BILIBILI_MCP_TIMEOUT_MS=8000
BILIBILI_SEARCH_RECALL_LIMIT=10
BILIBILI_DETAIL_CANDIDATE_LIMIT=5
BILIBILI_RESULT_LIMIT=5
BILIBILI_MIN_CURRENT_RESULTS=3
# Discover current/previous patch windows online and cache them locally in memory.
# TFT uses Riot's official game-update page. Golden Spatula uses a configurable
# update-announcement index when static windows are not supplied.
BILIBILI_PATCH_DISCOVERY_MODE=auto
BILIBILI_PATCH_DISCOVERY_TIMEOUT_MS=5000
BILIBILI_PATCH_DISCOVERY_TTL_MS=21600000
BILIBILI_TFT_PATCH_SOURCE_URL=https://teamfighttactics.leagueoflegends.com/en-us/news/game-updates/
BILIBILI_GOLDEN_SPATULA_PATCH_SOURCE_URL=https://newgame.17173.com/game-newslist-4075117.html
# Patch windows are isolated by ecosystem. JSON array example:
# [{"patchId":"18.3","startAt":"2026-08-05T06:00:00+08:00","endAt":"2026-08-19T06:00:00+08:00"}]
BILIBILI_TFT_PATCH_WINDOWS_JSON=[]
BILIBILI_GOLDEN_SPATULA_PATCH_WINDOWS_JSON=[]
BILIBILI_GOLDEN_SPATULA_CURRENT_PATCH=
BILIBILI_GOLDEN_SPATULA_PREVIOUS_PATCH=
MODEL_NAME=your_model_id

# Optional TFTAgent behavior.
TFT_AGENT_LLM_MODE=auto
TFT_AGENT_LLM_TIMEOUT_MS=3000
TFT_AGENT_LLM_TEMPERATURE=0
TFT_AGENT_LLM_MAX_TOKENS=500
# Outer request deadline. It must cover parsing, retrieval and answer generation,
# so it must be longer than any individual provider timeout.
TFT_AGENT_RUN_DEADLINE_MS=60000

# Optional evidence-backed conclusion generation (disabled by default)
TFT_AGENT_CONCLUSION_MODE=off
TFT_AGENT_CONCLUSION_PROVIDER=openai_compatible
TFT_AGENT_CONCLUSION_MODEL=
TFT_AGENT_CONCLUSION_ENDPOINT=
TFT_AGENT_CONCLUSION_API_KEY=
TFT_AGENT_CONCLUSION_TIMEOUT_MS=10000
TFT_AGENT_CONCLUSION_MAX_OUTPUT_TOKENS=1600
TFT_AGENT_CONCLUSION_MAX_CORRECTIONS=2
TFT_AGENT_CONCLUSION_THINKING=
TFT_AGENT_CONCLUSION_REASONING_EFFORT=minimal
TFT_AGENT_LLM_RESPONSE_FORMAT=1

# Optional persistent semantic index. The preferred AIHubMix-compatible base URL
# is used here because it is more reliable on networks where aihubmix.com fails.
# Knowledge mode keeps the SQLite/TF-IDF index available even when remote
# embeddings are disabled.
TFT_AGENT_KNOWLEDGE_MODE=on
TFT_AGENT_EMBEDDING_MODE=off
TFT_AGENT_EMBEDDING_PROVIDER=openai_compatible
TFT_AGENT_EMBEDDING_ENDPOINT=https://api.inferera.com/v1
TFT_AGENT_EMBEDDING_MODEL=text-embedding-3-small
TFT_AGENT_EMBEDDING_DIMENSIONS=1536
TFT_AGENT_EMBEDDING_API_KEY=
TFT_AGENT_EMBEDDING_BATCH_SIZE=64
TFT_AGENT_EMBEDDING_TIMEOUT_MS=30000
TFT_AGENT_SEMANTIC_INDEX_PATH=.cache/semantic-index.sqlite
TFT_AGENT_OFFICIAL_CATALOG_TIMEOUT_MS=10000

# Storage architecture (local defaults may remain sqlite; production uses postgres+redis).
TFT_AGENT_PERSISTENT_STORE=sqlite
TFT_AGENT_EPHEMERAL_STORE=sqlite
TFT_AGENT_PROCESS_ROLE=all
TFT_AGENT_STORAGE_ALLOW_MEMORY_FALLBACK=true
# DATABASE_URL=postgresql://tftagent_app:password@127.0.0.1:5432/tftagent
# REDIS_URL=redis://:password@127.0.0.1:6379/0
TFT_AGENT_REDIS_PREFIX=tft:v1
TFT_AGENT_STATS_PRIMARY_PROVIDER=metatft
TFT_AGENT_STATS_SHADOW_PROVIDER=off
TFT_AGENT_PROVIDER_FALLBACK=off

# MetaTFT Player Match MCP. Disabled by default because the upstream has no
# long-term stability or commercial-use guarantee. PBE and NA are isolated
# kill switches; neither route ever falls back to the other or to OP.GG.
METATFT_PLAYER_MATCH_ENABLED=false
METATFT_PBE_ENABLED=false
METATFT_NA_ENABLED=false
METATFT_PBE_DEFAULT_SEASON=set18-pbe
METATFT_NA_DEFAULT_SEASON=set17-live
PBE_TAG_PATTERN=^PBE[0-9]+$
NA_TAG_PATTERN=^NA[0-9]+$

# Optional current_stats daily job. The one-shot command is `npm run stats:daily`.
# The Windows installer defaults to 04:15 local time; the Node daemon reads
# CURRENT_STATS_DAILY_AT. A webhook receives a JSON payload only after all
# retries fail.
CURRENT_STATS_DAILY_AT=04:15
CURRENT_STATS_MAX_ATTEMPTS=3
CURRENT_STATS_RETRY_DELAY_MS=5000
CURRENT_STATS_STALE_LOCK_MS=7200000
CURRENT_STATS_JOB_TIMEOUT_MS=180000
CURRENT_STATS_ALERT_WEBHOOK=
CURRENT_STATS_SEASON=set17-live
CURRENT_STATS_PATCH=17.8
CURRENT_STATS_RANK=CHALLENGER,DIAMOND,EMERALD,GRANDMASTER,MASTER,PLATINUM
CURRENT_STATS_DAYS=3
CURRENT_STATS_REGION=global
CURRENT_STATS_LOCALE=zh-CN
CURRENT_STATS_TTL_HOURS=48

# current_stats semanticProjection policy. Critical rank boundaries are
# deliberately empty by default; configure values such as 1,3,4,10 only after
# an explicit product decision.
CURRENT_STATS_AVG_PLACEMENT_DECIMALS=2
CURRENT_STATS_RATE_PERCENTAGE_DECIMALS=1
CURRENT_STATS_RANK_CHANGE_THRESHOLD=2
CURRENT_STATS_CRITICAL_RANK_BOUNDARIES=

# Optional hybrid strategy answer. When these overrides are omitted, the coach
# reuses TFT_AGENT_CONCLUSION_* provider settings. MetaTFT remains the only
# authority for "current best"; video evidence is used only for reasons and
# conditional advice.
# TFT_AGENT_COACH_MODE=on
# TFT_AGENT_COACH_PROVIDER=openai_compatible
# TFT_AGENT_COACH_ENDPOINT=
# TFT_AGENT_COACH_MODEL=
# TFT_AGENT_COACH_API_KEY=
# TFT_AGENT_COACH_TIMEOUT_MS=10000
# TFT_AGENT_COACH_MAX_OUTPUT_TOKENS=1600

# Optional at-rest encryption for OP.GG player PUUIDs. Use a long random
# secret. When omitted, PUUIDs are resolved for each poll and are not stored.
# OPGG_PUUID_ENCRYPTION_KEY=
# Optional timeout for one OP.GG LLM teaching attempt. Invalid model output
# may be retried once, so the browser allows roughly twice this duration.
# TFT_AGENT_OPGG_TEACHING_TIMEOUT_MS=60000

# YouTube extraction uses an OpenAI-compatible endpoint and defaults to the
# coach/conclusion provider when these overrides are omitted.
# TFT_AGENT_YOUTUBE_EXTRACTION_ENDPOINT=https://api.deepseek.com/v1
# TFT_AGENT_YOUTUBE_EXTRACTION_MODEL=deepseek-v4-flash
# TFT_AGENT_YOUTUBE_EXTRACTION_API_KEY=
# TFT_AGENT_YOUTUBE_EXTRACTION_TIMEOUT_MS=30000
# TFT_AGENT_YOUTUBE_EXTRACTION_MAX_OUTPUT_TOKENS=4000
# DeepSeek V4 defaults to thinking mode; JSON extraction should keep this disabled.
# Use auto to omit the provider-specific request field on other compatible endpoints.
# TFT_AGENT_YOUTUBE_EXTRACTION_THINKING_MODE=disabled
# Transient HTTP/TLS failures are retried before a segment is quarantined.
# TFT_AGENT_YOUTUBE_EXTRACTION_TRANSPORT_RETRIES=2
# TFT_AGENT_YOUTUBE_EXTRACTION_TRANSPORT_RETRY_DELAY_MS=1000
# TFT_AGENT_YOUTUBE_EXTRACTION_RETRY_EMPTY_ONCE=true
# TFT_AGENT_YOUTUBE_EXTRACTION_PROMPT_VERSION=youtube-guide-extraction.v6
