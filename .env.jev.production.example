# Loaded only by the app service. Copy to .env.jev.production on the host.
# Keep off until the release image is verified. Use shadow for observation or control for bounded ReAct intent hints.
TYPESAFE_API_KEY=replace-me
TFT_AGENT_JEV_INTENT_MODE=off
TFT_AGENT_JEV_INTENT_TIMEOUT_MS=1500
TFT_AGENT_JEV_INTENT_SAMPLE_RATE=0.05
TFT_AGENT_JEV_INTENT_MAX_REQUESTS=100
TFT_AGENT_JEV_INTENT_CONTROL_MIN_CONFIDENCE=0.70
